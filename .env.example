# --- LiveTranslate Server (Go) configuration (copy to .env and fill) ---
# NEVER commit a real .env. Variable names and SAFE placeholders only.
# Full development/staging/production matrix: docs/ENVIRONMENTS.md.

# Environment profile: development | staging | production.
# production enables the static boot validation (docs/ENVIRONMENTS.md §生产启动校验).
APP_ENV=development

# Database (pgx-native URL). Local dev without a server is NOT supported —
# the Go server is PostgreSQL-only by design (see README §Testing).
# DATABASE_URL=postgres://livetranslate:REPLACE_WITH_STRONG_PASSWORD@db:5432/livetranslate
DATABASE_URL=postgres://oo@/livetranslate_dev?host=/tmp&port=5432

# JWT signing secret for access tokens. Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# Optional prior secret during a rotation window: verified (never signed
# with) so outstanding access tokens survive the key change. Empty normally.
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=livetranslate-server

# Public origin the server is reachable at (email links point here).
# REQUIRED in production (validation refuses to boot without it). No
# guessed domains in this file — set the real one per environment.
PUBLIC_BASE_URL=
# Path of the password-reset deep link (must match the iOS app's router
# and the AASA component declaration).
PASSWORD_RESET_PATH=/reset-password

# Sign in with Apple (legacy provider, kept for existing clients).
APPLE_BUNDLE_ID=com.livetranslate.ios
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Apple Developer Team ID for /.well-known/apple-app-site-association.
# EMPTY until the real 10-char Team ID is configured — the server then
# serves a valid but EMPTY app list (never a guessed value) and logs a
# warning at boot.
AASA_TEAM_ID=

# Registration policy — the single source of truth surfaced via
# GET /v1/auth/capabilities and the admin dashboard (read-only there).
# open | invite_only | disabled. Unknown values fail CLOSED.
REGISTRATION_MODE=open
# Legacy boolean (kept for compatibility; REGISTRATION_MODE wins when set).
REQUIRE_INVITATION=false

# DEV-ONLY login endpoint (POST /v1/auth/dev) and dev conveniences.
# MUST stay false everywhere except throwaway local environments.
DEV_LOGIN_ENABLED=false
DEV_MODE=false

# Argon2id parameters for password hashing (KiB / iterations / lanes).
# Defaults are calibrated ~120-200ms verify on a small ARM64 server.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Email verification codes / password reset tokens.
EMAIL_VERIFY_TTL=10m
PASSWORD_RESET_TTL=30m
RESEND_COOLDOWN=60s

# SMTP (production). Without SMTP and without DEV_MODE, registration
# refuses with 503 rather than silently swallowing codes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=livetranslate@example.com
SMTP_FROM_NAME=LiveTranslate
# starttls (587) | smtps (465, implicit TLS) | none (dev only; production
# validation rejects none).
SMTP_TLS_MODE=starttls
SMTP_CONNECT_TIMEOUT=15s
SMTP_SEND_TIMEOUT=20s
# Dev-only mail capture (Mailpit): MAILPIT_BASE_URL=http://127.0.0.1:8025
MAILPIT_BASE_URL=

# Rate limiting.
AUTH_RATE_LIMIT_PER_MINUTE=30
LOGIN_FAIL_WINDOW=15m
LOGIN_FAIL_MAX=10
IP_FAIL_MAX=30

# Sync protocol.
SCHEMA_VERSION=1
MIN_CLIENT_SCHEMA_VERSION=1
MAX_CLIENT_SCHEMA_VERSION=1
TOMBSTONE_RETENTION_DAYS=180
MAX_BODY_BYTES=10485760

# Retention for the maintenance cleanup (days; 0 = keep forever).
LOGIN_EVENTS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Observability. /metrics carries aggregate counters only (no emails, no
# tokens, no transcript text); gate it at the reverse proxy. pprof answers
# loopback clients only and defaults OFF.
METRICS_ENABLED=false
PPROF_ENABLED=false
LOG_LEVEL=info

# Listeners.
LISTEN_ADDR=127.0.0.1:8000
ADMIN_LISTEN_ADDR=127.0.0.1:8081
ADMIN_SESSION_TTL=8h

# Reverse-proxy client IP: ONLY direct peers listed here may set
# X-Forwarded-For (CIDR list, comma-separated). Empty = trust nobody.
TRUSTED_PROXIES=
# CORS: allowed browser origins for the API, comma-separated.
CORS_ORIGINS=

# Compose-side Postgres credentials.
POSTGRES_USER=livetranslate
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=livetranslate
