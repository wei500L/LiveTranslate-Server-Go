# --- LiveTranslate Server (Go) configuration (copy to .env and fill) ---
# NEVER commit a real .env. Variable names and SAFE placeholders only.

# Database (pgx-native URL). Local dev without a server is NOT supported —
# the Go server is PostgreSQL-only by design (see README §Testing).
# DATABASE_URL=postgres://livetranslate:REPLACE_WITH_STRONG_PASSWORD@db:5432/livetranslate
DATABASE_URL=postgres://oo@/livetranslate_dev?host=/tmp&port=5432

# JWT signing secret for access tokens. Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=livetranslate-server

# Sign in with Apple (legacy provider, kept for existing clients).
APPLE_BUNDLE_ID=com.livetranslate.ios
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# DEV-ONLY login endpoint (POST /v1/auth/dev) and dev conveniences.
# MUST stay false everywhere except throwaway local environments.
DEV_LOGIN_ENABLED=false
DEV_MODE=false

# Argon2id parameters for password hashing (KiB / iterations / lanes).
# Defaults are calibrated ~120-200ms verify on a small ARM64 server.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Email verification codes / password reset tokens.
EMAIL_VERIFY_TTL=10m
PASSWORD_RESET_TTL=30m
RESEND_COOLDOWN=60s

# SMTP (production). Without SMTP and without DEV_MODE, registration
# refuses with 503 rather than silently swallowing codes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=livetranslate@example.com
SMTP_USE_TLS=true
# Dev-only mail capture (Mailpit): MAILPIT_BASE_URL=http://127.0.0.1:8025

# Rate limiting.
AUTH_RATE_LIMIT_PER_MINUTE=30
LOGIN_FAIL_WINDOW=15m
LOGIN_FAIL_MAX=10
IP_FAIL_MAX=30

# Registration invitations (set true to require an invitation code).
REQUIRE_INVITATION=false

# Sync protocol.
SCHEMA_VERSION=1
MIN_CLIENT_SCHEMA_VERSION=1
MAX_CLIENT_SCHEMA_VERSION=1
TOMBSTONE_RETENTION_DAYS=180
MAX_BODY_BYTES=10485760

# Listeners.
LISTEN_ADDR=127.0.0.1:8000
ADMIN_LISTEN_ADDR=127.0.0.1:8081
ADMIN_SESSION_TTL=8h

# Reverse-proxy client IP: ONLY direct peers listed here may set
# X-Forwarded-For (CIDR list, comma-separated). Empty = trust nobody.
TRUSTED_PROXIES=
# CORS: allowed browser origins for the API, comma-separated.
CORS_ORIGINS=

# Compose-side Postgres credentials.
POSTGRES_USER=livetranslate
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=livetranslate
